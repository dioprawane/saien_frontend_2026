NEXT_PUBLIC_BACK_API_TARGET=local
NEXT_PUBLIC_BACK_API_LOCAL_URL=http://localhost:8090
NEXT_PUBLIC_BACK_API_PROD_URL=https://api.saien.org
# Optional: force a specific API base URL and bypass target rules.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8090
 
# Optional: internal API URL used by Next.js server-side rendering in containerized runtime.
API_BASE_URL_INTERNAL=http://host.docker.internal:8090
