{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/missions/layout,_N_T_/missions/[slug]/layout,_N_T_/missions/[slug]/page,_N_T_/missions/partenariats"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/missions/$d$slug/__PAGE__",
    "/missions/$d$slug",
    "/missions",
    "/_index",
    "/_head"
  ]
}