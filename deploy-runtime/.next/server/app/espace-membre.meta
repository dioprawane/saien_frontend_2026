{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/espace-membre/layout,_N_T_/espace-membre/page,_N_T_/espace-membre"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/espace-membre/__PAGE__",
    "/espace-membre",
    "/_index",
    "/_head"
  ]
}